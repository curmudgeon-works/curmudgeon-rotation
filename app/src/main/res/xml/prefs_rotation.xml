<!-- Defaults must match Prefs.kt. Which keys show in Simple mode: SimpleModeFilter.SIMPLE_KEYS. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="category_rule_end"
        app:title="@string/pref_category_rule_end">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="restore_on_leave"
            app:summary="@string/pref_restore_summary"
            app:title="@string/pref_restore" />
    </PreferenceCategory>

    <!-- moved here from the Lock tile's screen when built-in tiles stopped being changeable -->
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="category_lock"
        app:title="@string/pref_category_lock">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="lock_release_on_turn"
            app:summary="@string/pref_lock_release_on_turn_summary"
            app:title="@string/pref_lock_release_on_turn" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="category_mechanism"
        app:title="@string/pref_category_mechanism">

        <ListPreference
            app:defaultValue="overlay"
            app:entries="@array/tile_mechanism_entries"
            app:entryValues="@array/tile_mechanism_values"
            app:iconSpaceReserved="false"
            app:key="tile_mechanism"
            app:title="@string/pref_tile_mechanism"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="accessibility"
            app:entries="@array/overlay_type_entries"
            app:entryValues="@array/overlay_type_values"
            app:iconSpaceReserved="false"
            app:key="overlay_type"
            app:title="@string/pref_overlay_type"
            app:useSimpleSummaryProvider="true" />

        <!-- moved here from the main screen's status rows: the accessibility overlay needs no permission -->
        <Preference
            app:iconSpaceReserved="false"
            app:key="overlay_permission"
            app:title="@string/pref_overlay_permission" />
    </PreferenceCategory>
</PreferenceScreen>
