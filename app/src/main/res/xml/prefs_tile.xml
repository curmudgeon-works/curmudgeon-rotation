<!-- "Quick Settings tiles": one row per tile, no groups. Built-in rows open their own screens (SettingsActivity.TILE_SCREENS);
     custom tile rows are added in code (SettingsFragment, order 100 + slot) and open TileEditorActivity.
     The quick-actions notification sits below a divider. Defaults must match Prefs.kt.
     Which keys show in Simple mode: SimpleModeFilter.SIMPLE_KEYS. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:icon="@drawable/ic_rotation_auto"
        app:key="tile_rotate"
        app:order="0"
        app:summary="@string/tile_rotate_summary"
        app:title="@string/tile_label" />

    <Preference
        app:icon="@drawable/ic_rotation_landscape"
        app:key="tile_lock"
        app:order="1"
        app:summary="@string/tile_lock_summary"
        app:title="@string/tile_force_landscape_label" />

    <Preference
        app:icon="@drawable/ic_rotation_portrait"
        app:key="tile_portrait"
        app:order="2"
        app:summary="@string/tile_portrait_summary"
        app:title="@string/tile_force_portrait_label" />

    <Preference
        app:icon="@drawable/ic_add"
        app:key="add_custom_tile"
        app:order="200"
        app:summary="@string/add_custom_tile_summary"
        app:title="@string/add_custom_tile" />

    <Preference
        app:key="tiles_divider"
        app:layout="@layout/pref_divider"
        app:order="300"
        app:selectable="false" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:iconSpaceReserved="true"
        app:key="quick_actions_notification"
        app:order="301"
        app:summary="@string/pref_quick_actions_summary"
        app:title="@string/pref_quick_actions" />
</PreferenceScreen>
