<!-- @string/lock_tap_landscape Built-in tiles can't be changed: only "Add to Quick Settings" is a setting, the rest says what the tile does.
     Other actions live on custom tiles. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <CheckBoxPreference
        app:iconSpaceReserved="false"
        app:key="add_tile_lock"
        app:persistent="false"
        app:summary="@string/add_tile_summary"
        app:title="@string/add_tile" />

    <Preference
        app:iconSpaceReserved="false"
        app:key="tile_lock_tap"
        app:selectable="false"
        app:summary="@string/tile_no_double_tap"
        app:title="@string/tile_single_tap" />

    <Preference
        app:iconSpaceReserved="false"
        app:key="tile_lock_double_tap"
        app:selectable="false"
        app:summary=""
        app:title="@string/tile_double_tap" />

    <Preference
        app:iconSpaceReserved="false"
        app:key="tile_lock_long_press"
        app:selectable="false"
        app:summary="@string/tile_long_press_summary"
        app:title="@string/tile_long_press" />
</PreferenceScreen>
