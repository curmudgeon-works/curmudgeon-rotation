<!-- Settings home: one row per section, like Curmudgeon Keyboard and Browser. Rows open prefs_*.xml screens (see SettingsActivity.SECTIONS). -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:icon="@drawable/ic_apps"
        app:key="section_detection"
        app:summary="@string/settings_section_detection_summary"
        app:title="@string/settings_section_detection" />

    <Preference
        app:icon="@drawable/ic_screen_rotation"
        app:key="section_rotation"
        app:summary="@string/settings_section_rotation_summary"
        app:title="@string/settings_section_rotation" />

    <Preference
        app:icon="@drawable/ic_toggle"
        app:key="section_tile"
        app:summary="@string/settings_section_tile_summary"
        app:title="@string/settings_section_tile" />

    <Preference
        app:icon="@drawable/ic_list"
        app:key="section_rules"
        app:summary="@string/settings_section_rules_summary"
        app:title="@string/settings_section_rules" />

    <Preference
        app:icon="@drawable/ic_info"
        app:key="about"
        app:title="@string/pref_about" />
</PreferenceScreen>
