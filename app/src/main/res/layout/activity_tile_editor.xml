<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/custom_tile_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/TextAppearance.Curmudgeon.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/custom_tile_name" />

            <EditText
                android:id="@+id/nameField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/custom_tile_name_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="24"
                android:singleLine="true" />

            <TextView
                style="@style/TextAppearance.Curmudgeon.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:layout_marginBottom="8dp"
                android:text="@string/custom_tile_icon" />

            <LinearLayout
                android:id="@+id/iconGrid"
                style="@style/Curmudgeon.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/TextAppearance.Curmudgeon.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:layout_marginBottom="8dp"
                android:text="@string/custom_tile_action" />

            <RadioGroup
                android:id="@+id/targetGroup"
                style="@style/Curmudgeon.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/custom_tile_action_help"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/addToQuickSettings"
                style="@style/Widget.Curmudgeon.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/custom_tile_save_and_add" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/screen_padding">

        <Button
            android:id="@+id/cancelButton"
            style="@style/Widget.Curmudgeon.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.Curmudgeon.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/custom_tile_save" />
    </LinearLayout>
</LinearLayout>
